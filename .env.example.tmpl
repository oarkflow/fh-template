# Development binds to loopback. Set an explicit address/origin to expose it on a trusted network.
APP_ENV=development
APP_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:8080
APP_DATABASE_URL='file:data/app.db?_pragma=foreign_keys(1)'
# base64url encoding of exactly 32 development-only bytes
APP_SESSION_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY
APP_LOGIN_USER=admin
APP_LOGIN_PASSWORD=change-me-in-development
APP_OPERATIONS_TOKEN=change-me-ops-token
APP_REQUEST_TIMEOUT=15s
APP_MAX_BODY_BYTES=1048576
APP_RATE_LIMIT=120
# DDoS shield: proof-of-work is demanded only while the server is under pressure.
# APP_SHIELD=off disables it. CAPACITY = in-flight requests (and RATE = req/s)
# treated as 100% pressure; MAX_BITS caps puzzle difficulty (each bit doubles the work).
APP_SHIELD=on
APP_SHIELD_CAPACITY=1000
APP_SHIELD_RATE=2000
APP_SHIELD_MAX_BITS=22
# Requests per minute one solved pass may make while the shield is active.
APP_SHIELD_PASS_BUDGET=600
APP_SECURE_TRANSPORT_KEY_ID=app-transport-v1
APP_RESPONSE_SIGNING_KEY_ID=app-response-v1
# Empty keys are permitted only in development and are regenerated at startup.
APP_SECURE_TRANSPORT_KEY=
APP_RESPONSE_SIGNING_PRIVATE_KEY=
# Production examples:
# APP_SESSION_SECRET_FILE=/run/secrets/session
# APP_LOGIN_PASSWORD_FILE=/run/secrets/login-password
# APP_OPERATIONS_TOKEN_FILE=/run/secrets/operations-token
# APP_SECURE_TRANSPORT_KEY_FILE=/run/secrets/transport-key
# APP_RESPONSE_SIGNING_PRIVATE_KEY_FILE=/run/secrets/response-signing-key

# --- Reverse proxy / CDN / load balancer -----------------------------------
# Comma-separated CIDRs of the proxies in front of this server. Forwarding
# headers (X-Forwarded-For, CF-Connecting-IP, ...) are believed ONLY from these
# peers; empty means "directly exposed, trust no header". Required behind a
# proxy - otherwise every client looks like the proxy and one ban locks out all.
APP_TRUSTED_PROXIES=
# on: accept HAProxy PROXY protocol v1/v2 (L4 load balancers) from the proxies above.
APP_PROXY_PROTOCOL=off
# Refuse connections that do not come from APP_TRUSTED_PROXIES (stops attackers
# bypassing the CDN by hitting the origin directly). Default on when proxies are set.
APP_ORIGIN_LOCK=on
# Statically blocked client networks (CIDRs), checked before anything else.
APP_DENY_CIDRS=
# Per-IP login/bootstrap attempts per minute (stricter than APP_RATE_LIMIT).
APP_LOGIN_RATE_LIMIT=10
# on: start with the shield at maximum difficulty. Toggle at runtime with
# POST /_ops/shield/attack?on=1 (operations token).
APP_UNDER_ATTACK=off

# --- Durable state & backups ------------------------------------------------
# Sessions and (with Redis) rate-limit counters survive restarts: file-backed in
# APP_STATE_DIR by default, or shared across instances via Redis.
APP_STATE_DIR=data
# APP_REDIS_URL=redis://127.0.0.1:6379/0          # or rediss://... ; _FILE variant supported
# SQLite snapshots (VACUUM INTO), pruned to APP_BACKUP_KEEP. Default: every 6h in
# production, off in development. Production REQUIRES APP_BACKUP_KEY (AES-256-GCM).
# APP_BACKUP_INTERVAL=6h                          # or "off"
# APP_BACKUP_DIR=data/backups
# APP_BACKUP_KEEP=14
# APP_BACKUP_KEY_FILE=/run/secrets/backup-key     # go run ./cmd/server -generate-backup-key
# Copy backups off the host too; a backup on the same disk does not survive the disk.
