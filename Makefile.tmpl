GO ?= go
NPM ?= npm

.PHONY: check test run keys wasm wasm-docker backup e2e frontend check-secure-fetch test-secure-fetch

check:
	$(GO) test ./...

# Fails if any frontend source file outside lib/secure-client.ts calls
# fetch() directly or imports the plain-fetch helper (lib/http.ts) - every
# protected /api/* request must go through the WASM secure-fetch client.
# Run on its own (not part of `check`, which stays Node-free) and as part
# of `frontend`, since anyone rebuilding frontend assets already has npm.
check-secure-fetch:
	@command -v $(NPM) >/dev/null 2>&1 || (echo "npm was not found on PATH. Install Node.js 22.6+." >&2; exit 1)
	cd web/frontend && $(NPM) run check:secure-fetch

test-secure-fetch:
	node --test web/wasm/coalesce.test.mjs web/wasm/pow.test.mjs

test:
	$(GO) test ./...

run:
	./run.sh

keys:
	@$(GO) run ./cmd/server -generate-transport-key
	@$(GO) run ./cmd/server -generate-signing-key

# web/public/app.js and app.css are build output, not checked in (see
# web/frontend/README.md) - the server has nothing to serve at /assets/*
# until this has run at least once. Also re-run after changing
# web/frontend/src. Requires Node.js 22.6+.
frontend: check-secure-fetch
	@command -v $(NPM) >/dev/null 2>&1 || (echo "npm was not found on PATH. Install Node.js 22.6+." >&2; exit 1)
	cd web/frontend && $(NPM) install && $(NPM) run build

# This project requires Go 1.27.3. Use a TinyGo release whose compatibility
# matrix includes Go 1.27 (TinyGo 0.44.x) and put Go 1.27.3 first on PATH:
#   go install golang.org/dl/go1.27.3@latest && go1.27.3 download
#   PATH="$$(go1.27.3 env GOROOT)/bin:$$PATH" make wasm
TINYGO ?= tinygo
# The client pins the server key at runtime from /secure-config.json (served over
# TLS, with WASM/runtime subresource-integrity), so no keys are compiled in.
# Hermetic alternative (no local TinyGo): make wasm-docker
wasm:
	@mkdir -p web/wasm
	@command -v $(TINYGO) >/dev/null 2>&1 || (echo "tinygo was not found on PATH. Install it (e.g. 'brew install tinygo') or use 'make wasm-docker'." >&2; exit 1)
	@command -v wasm-opt >/dev/null 2>&1 || (echo "wasm-opt was not found on PATH (install binaryen) or use 'make wasm-docker'." >&2; exit 1)
	$(TINYGO) build -target wasm -no-debug -o web/wasm/securefetch.wasm github.com/oarkflow/fh/wasm/cmd/securefetch
	@echo "tinygo build: $$(wc -c < web/wasm/securefetch.wasm) bytes"
	cp "$$($(GO) list -m -f '{{.Dir}}' github.com/oarkflow/fh)/wasm/cmd/securefetch/wasm_exec.js" web/wasm/wasm_exec.js
	$(GO) run github.com/oarkflow/fh/wasm/cmd/manifest -dir web/wasm

wasm-docker:
	docker run --rm -v "$$PWD":/src -w /src -e GOFLAGS=-buildvcs=false tinygo/tinygo:latest \
		tinygo build -target wasm -no-debug -o web/wasm/securefetch.wasm github.com/oarkflow/fh/wasm/cmd/securefetch
	cp "$$($(GO) list -m -f '{{.Dir}}' github.com/oarkflow/fh)/wasm/cmd/securefetch/wasm_exec.js" web/wasm/wasm_exec.js
	$(GO) run github.com/oarkflow/fh/wasm/cmd/manifest -dir web/wasm

# One-off encrypted database snapshot into APP_BACKUP_DIR (set APP_BACKUP_KEY).
backup:
	$(GO) run ./cmd/server -backup

# Real server + real headless Chrome + the real UI. Needs `make frontend` first.
e2e:
	node scripts/e2e.mjs
