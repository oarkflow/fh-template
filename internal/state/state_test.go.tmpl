package state

import (
	"os"
	"strconv"
	"testing"
	"time"

	"github.com/oarkflow/fh/pkg/storage/kv"
)

func exercise(t *testing.T, s kv.Store) {
	t.Helper()
	if err := s.Set("a", []byte("1"), time.Minute); err != nil {
		t.Fatal(err)
	}
	if v, ok, err := s.Get("a"); err != nil || !ok || string(v) != "1" {
		t.Fatalf("get: %q %v %v", v, ok, err)
	}
	if _, ok, _ := s.Get("missing"); ok {
		t.Fatal("missing key reported present")
	}
	// Atomic counter under concurrency.
	done := make(chan struct{})
	for i := 0; i < 20; i++ {
		go func() {
			defer func() { done <- struct{}{} }()
			if err := s.Mutate("ctr", func(cur []byte, exists bool) ([]byte, time.Duration, bool, error) {
				n := 0
				if exists {
					n, _ = strconv.Atoi(string(cur))
				}
				return []byte(strconv.Itoa(n + 1)), time.Minute, true, nil
			}); err != nil {
				t.Error(err)
			}
		}()
	}
	for i := 0; i < 20; i++ {
		<-done
	}
	if v, _, _ := s.Get("ctr"); string(v) != "20" {
		t.Fatalf("lost updates: counter=%s", v)
	}
	_ = s.Set("short", []byte("x"), 100*time.Millisecond)
	time.Sleep(250 * time.Millisecond)
	if _, ok, _ := s.Get("short"); ok {
		t.Fatal("expired key still present")
	}
	if err := s.Delete("a"); err != nil {
		t.Fatal(err)
	}
	if _, ok, _ := s.Get("a"); ok {
		t.Fatal("deleted key present")
	}
}

func TestFileStoreSurvivesRestartAndIsPrivate(t *testing.T) {
	dir := t.TempDir()
	s, err := Open("sessions", "", dir)
	if err != nil {
		t.Fatal(err)
	}
	if err := s.Set("sid", []byte("principal"), time.Hour); err != nil {
		t.Fatal(err)
	}
	s.Close()
	info, err := os.Stat(dir + "/sessions")
	if err != nil || info.Mode().Perm() != 0o700 {
		t.Fatalf("state dir mode: %v %v", info, err)
	}
	s2, err := Open("sessions", "", dir) // "restart"
	if err != nil {
		t.Fatal(err)
	}
	defer s2.Close()
	if v, ok, _ := s2.Get("sid"); !ok || string(v) != "principal" {
		t.Fatal("session lost across restart")
	}
	exercise(t, s2)
}

// Runs against a real Redis only when REDIS_TEST_URL is set, e.g.
//
//	REDIS_TEST_URL=redis://127.0.0.1:6379/15 go test ./internal/state
func TestRedisStore(t *testing.T) {
	url := os.Getenv("REDIS_TEST_URL")
	if url == "" {
		t.Skip("REDIS_TEST_URL not set")
	}
	s, err := NewRedisStore(url, "fhtest:"+strconv.FormatInt(time.Now().UnixNano(), 36)+":")
	if err != nil {
		t.Fatal(err)
	}
	defer s.Close()
	exercise(t, s)
}
