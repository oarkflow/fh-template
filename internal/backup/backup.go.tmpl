// Package backup takes consistent online snapshots of the SQLite database and
// restores them. A snapshot is produced with VACUUM INTO (a transactionally
// consistent copy that does not block readers or writers for long), written
// with owner-only permissions, optionally encrypted with AES-256-GCM, and old
// snapshots beyond the retention count are pruned.
//
// Backups contain user data, so in production they are encrypted at rest and
// should also be copied off the host (object storage, another machine);
// a backup on the same disk does not survive the disk.
package backup

import (
	"context"
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"database/sql"
	"errors"
	"fmt"
	"io"
	"log/slog"
	"os"
	"path/filepath"
	"sort"
	"strings"
	"time"
)

// Execer is satisfied by *sql.DB and the squealx DB.
type Execer interface {
	ExecContext(ctx context.Context, query string, args ...any) (sql.Result, error)
}

const (
	magic      = "FHB1"
	plainExt   = ".db"
	cryptedExt = ".db.enc"
	prefix     = "app-"
)

// Config controls Run.
type Config struct {
	Dir  string
	Keep int
	// Key, when 32 bytes, encrypts snapshots with AES-256-GCM.
	Key []byte
	Now func() time.Time
}

// Run writes one snapshot and prunes old ones. It returns the final path.
func Run(ctx context.Context, db Execer, cfg Config) (string, error) {
	if cfg.Keep <= 0 {
		cfg.Keep = 14
	}
	if cfg.Now == nil {
		cfg.Now = time.Now
	}
	if len(cfg.Key) != 0 && len(cfg.Key) != 32 {
		return "", errors.New("backup: key must be 32 bytes")
	}
	if err := os.MkdirAll(cfg.Dir, 0o700); err != nil {
		return "", err
	}
	_ = os.Chmod(cfg.Dir, 0o700)
	stamp := cfg.Now().UTC().Format("20060102T150405Z")
	tmp := filepath.Join(cfg.Dir, "."+prefix+stamp+".tmp")
	_ = os.Remove(tmp)
	// VACUUM INTO takes a literal; our path contains only characters we control.
	if _, err := db.ExecContext(ctx, "VACUUM INTO '"+strings.ReplaceAll(tmp, "'", "''")+"'"); err != nil {
		return "", fmt.Errorf("snapshot: %w", err)
	}
	defer os.Remove(tmp)
	final := filepath.Join(cfg.Dir, prefix+stamp+plainExt)
	if len(cfg.Key) == 32 {
		final = filepath.Join(cfg.Dir, prefix+stamp+cryptedExt)
		if err := encryptFile(tmp, final, cfg.Key); err != nil {
			return "", err
		}
	} else {
		if err := os.Rename(tmp, final); err != nil {
			return "", err
		}
	}
	if err := os.Chmod(final, 0o600); err != nil {
		return "", err
	}
	prune(cfg.Dir, cfg.Keep)
	return final, nil
}

func prune(dir string, keep int) {
	entries, err := os.ReadDir(dir)
	if err != nil {
		return
	}
	var names []string
	for _, e := range entries {
		n := e.Name()
		if strings.HasPrefix(n, prefix) && (strings.HasSuffix(n, plainExt) || strings.HasSuffix(n, cryptedExt)) {
			names = append(names, n)
		}
	}
	sort.Strings(names) // timestamped names sort chronologically
	for len(names) > keep {
		_ = os.Remove(filepath.Join(dir, names[0]))
		names = names[1:]
	}
}

// Latest returns the newest snapshot in dir.
func Latest(dir string) (string, error) {
	entries, err := os.ReadDir(dir)
	if err != nil {
		return "", err
	}
	best := ""
	for _, e := range entries {
		n := e.Name()
		if strings.HasPrefix(n, prefix) && (strings.HasSuffix(n, plainExt) || strings.HasSuffix(n, cryptedExt)) && n > best {
			best = n
		}
	}
	if best == "" {
		return "", errors.New("backup: no snapshots found")
	}
	return filepath.Join(dir, best), nil
}

// Restore writes the snapshot at src (decrypting when needed) to dst. It never
// overwrites an existing dst: move the damaged database aside first, so a
// restore cannot destroy the only copy of the data.
func Restore(src, dst string, key []byte) error {
	if _, err := os.Stat(dst); err == nil {
		return fmt.Errorf("backup: %s already exists; move it aside before restoring", dst)
	}
	if err := os.MkdirAll(filepath.Dir(dst), 0o700); err != nil {
		return err
	}
	tmp := dst + ".restore.tmp"
	defer os.Remove(tmp)
	if strings.HasSuffix(src, cryptedExt) {
		if len(key) != 32 {
			return errors.New("backup: snapshot is encrypted; set APP_BACKUP_KEY")
		}
		if err := decryptFile(src, tmp, key); err != nil {
			return err
		}
	} else if err := copyFile(src, tmp); err != nil {
		return err
	}
	if err := os.Chmod(tmp, 0o600); err != nil {
		return err
	}
	return os.Rename(tmp, dst)
}

// Loop takes a snapshot every interval until ctx ends.
func Loop(ctx context.Context, db Execer, cfg Config, every time.Duration, log *slog.Logger) {
	t := time.NewTicker(every)
	defer t.Stop()
	for {
		select {
		case <-ctx.Done():
			return
		case <-t.C:
			path, err := Run(ctx, db, cfg)
			if err != nil {
				log.Error("backup failed", "error", err)
				continue
			}
			log.Info("backup written", "path", path)
		}
	}
}

func encryptFile(src, dst string, key []byte) error {
	plain, err := os.ReadFile(src)
	if err != nil {
		return err
	}
	gcm, err := newGCM(key)
	if err != nil {
		return err
	}
	nonce := make([]byte, gcm.NonceSize())
	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
		return err
	}
	out := append([]byte(magic), nonce...)
	// The header is authenticated so a swapped/edited prefix is detected.
	out = gcm.Seal(out, nonce, plain, []byte(magic))
	tmp := dst + ".tmp"
	if err := os.WriteFile(tmp, out, 0o600); err != nil {
		return err
	}
	return os.Rename(tmp, dst)
}

func decryptFile(src, dst string, key []byte) error {
	raw, err := os.ReadFile(src)
	if err != nil {
		return err
	}
	gcm, err := newGCM(key)
	if err != nil {
		return err
	}
	if len(raw) < len(magic)+gcm.NonceSize() || string(raw[:len(magic)]) != magic {
		return errors.New("backup: not an encrypted snapshot")
	}
	nonce := raw[len(magic) : len(magic)+gcm.NonceSize()]
	plain, err := gcm.Open(nil, nonce, raw[len(magic)+gcm.NonceSize():], []byte(magic))
	if err != nil {
		return errors.New("backup: decryption failed (wrong key or corrupted snapshot)")
	}
	return os.WriteFile(dst, plain, 0o600)
}

func newGCM(key []byte) (cipher.AEAD, error) {
	block, err := aes.NewCipher(key)
	if err != nil {
		return nil, err
	}
	return cipher.NewGCM(block)
}

func copyFile(src, dst string) error {
	in, err := os.Open(src)
	if err != nil {
		return err
	}
	defer in.Close()
	out, err := os.OpenFile(dst, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0o600)
	if err != nil {
		return err
	}
	if _, err := io.Copy(out, in); err != nil {
		out.Close()
		return err
	}
	return out.Close()
}
