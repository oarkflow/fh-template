var testSecret = []byte("0123456789abcdef0123456789abcdef")

type challengeBody struct {
	Challenge string `json:"challenge"`
	Bits      int    `json:"bits"`
}

// rig builds a fresh fh.App per request (App.Test serves one connection per
// call) around one shared Shield, so shield state persists across requests.
type rig struct{ s *Shield }

func newApp(t *testing.T, pressure *float64, cfg Config) (rig, *Shield) {
	t.Helper()
	cfg.Secret = testSecret
	cfg.MinBits, cfg.MaxBits = 8, 12
	cfg.Force = func() (float64, bool) { return *pressure, true }
	s, err := New(cfg)
	if err != nil {
		t.Fatal(err)
	}
	return rig{s}, s
}

func do(t *testing.T, r rig, hdr map[string]string) (*http.Response, string) {
	return doReq(t, r, "GET", "/api/x", hdr)
}

func doReq(t *testing.T, r rig, method, path string, hdr map[string]string) (*http.Response, string) {
	t.Helper()
	app := fh.New()
	app.Use(r.s.Middleware())
	app.Get("/api/x", func(c fh.Ctx) error { return c.SendString("ok") })
	req := httptest.NewRequest(method, "http://localhost"+path, nil)
	req.Header.Set("User-Agent", "test-ua")
	for k, v := range hdr {
		req.Header.Set(k, v)
	}
	resp, err := app.Test(req)
	if err != nil {
		t.Fatal(err)
	}
	b, _ := io.ReadAll(resp.Body)
	resp.Body.Close()
	return resp, string(b)
}

func solve(challenge string, bits int) string {
	for n := 0; ; n++ {
		c := strconv.Itoa(n)
		sum := sha256.Sum256([]byte(challenge + ":" + c))
		if leadingZeroBits(sum[:]) >= bits {
			return challenge + "." + c
		}
	}
}

func getChallenge(t *testing.T, app rig) challengeBody {
	t.Helper()
	resp, body := do(t, app, nil)
	if resp.StatusCode != 429 {
		t.Fatalf("want 429, got %d", resp.StatusCode)
	}
	var ch challengeBody
	if err := json.Unmarshal([]byte(body), &ch); err != nil || ch.Bits == 0 {
		t.Fatalf("bad challenge body %q: %v", body, err)
	}
	return ch
}

func TestCalmTrafficIsFree(t *testing.T) {
	p := 0.1
	app, s := newApp(t, &p, Config{})
	resp, body := do(t, app, nil)
	if resp.StatusCode != 200 || body != "ok" || s.Challenged.Load() != 0 {
		t.Fatalf("calm request challenged: %d %q", resp.StatusCode, body)
	}
}

func TestChallengeSolveAndPass(t *testing.T) {
	p := 1.0
	app, s := newApp(t, &p, Config{})
	ch := getChallenge(t, app)
	if ch.Bits != 12 {
		t.Fatalf("bits=%d", ch.Bits)
	}
	sol := solve(ch.Challenge, ch.Bits)
	resp, body := do(t, app, map[string]string{HeaderSolution: sol})
	if resp.StatusCode != 200 || body != "ok" {
		t.Fatalf("valid solution rejected: %d %q", resp.StatusCode, body)
	}
	var pass string
	for _, c := range resp.Cookies() {
		if c.Name == "fh_pass" {
			pass = c.Value
		}
	}
	if pass == "" {
		t.Fatal("no pass cookie issued")
	}
	resp, _ = do(t, app, map[string]string{"Cookie": "fh_pass=" + pass})
	if resp.StatusCode != 200 {
		t.Fatalf("pass rejected: %d", resp.StatusCode)
	}
	resp, _ = do(t, app, map[string]string{HeaderSolution: sol})
	if resp.StatusCode != 429 {
		t.Fatalf("replayed solution accepted: %d", resp.StatusCode)
	}
	if s.Solved.Load() != 1 {
		t.Fatalf("solved=%d", s.Solved.Load())
	}
}

func TestBindingAndForgery(t *testing.T) {
	p := 1.0
	app, _ := newApp(t, &p, Config{StrikeLimit: 1000})
	ch := getChallenge(t, app)
	sol := solve(ch.Challenge, ch.Bits)

	if resp, _ := do(t, app, map[string]string{HeaderSolution: sol, "User-Agent": "other"}); resp.StatusCode != 429 {
		t.Fatalf("solution accepted for a different binding: %d", resp.StatusCode)
	}
	for _, bad := range []string{"x.y.1", ch.Challenge + ".abc", strings.Repeat("a", 300), ch.Challenge + ".0"} {
		if resp, _ := do(t, app, map[string]string{HeaderSolution: bad}); resp.StatusCode != 429 {
			t.Fatalf("bad solution %q accepted", bad)
		}
	}
	if resp, _ := do(t, app, map[string]string{"Cookie": "fh_pass=AAAAAAAAAAA.AAAAAAAAAAAAAAAAAAAAAA"}); resp.StatusCode != 429 {
		t.Fatal("forged pass accepted")
	}
}

func TestExpiry(t *testing.T) {
	p := 1.0
	now := time.Unix(1_700_000_000, 0)
	app, _ := newApp(t, &p, Config{Now: func() time.Time { return now }, ChallengeTTL: time.Minute})
	ch := getChallenge(t, app)
	sol := solve(ch.Challenge, ch.Bits)
	now = now.Add(2 * time.Minute)
	if resp, _ := do(t, app, map[string]string{HeaderSolution: sol}); resp.StatusCode != 429 {
		t.Fatal("expired challenge accepted")
	}
}

func TestDifficultyScalesWithPressure(t *testing.T) {
	s, _ := New(Config{Secret: testSecret, MinBits: 10, MaxBits: 22, Threshold: 0.5})
	if s.Bits(0.49) != 0 || s.Bits(0.5) != 10 || s.Bits(1.0) != 22 || s.Bits(9) != 22 {
		t.Fatalf("bits: %d %d %d %d", s.Bits(0.49), s.Bits(0.5), s.Bits(1.0), s.Bits(9))
	}
	if !(s.Bits(0.6) < s.Bits(0.8)) {
		t.Fatal("difficulty must rise with pressure")
	}
}

func TestSkipAndConfigValidation(t *testing.T) {
	if _, err := New(Config{Secret: []byte("short")}); err == nil {
		t.Fatal("short secret accepted")
	}
	p := 1.0
	app, _ := newApp(t, &p, Config{Skip: func(c fh.Ctx) bool { return true }})
	if resp, _ := do(t, app, nil); resp.StatusCode != 200 {
		t.Fatalf("skipped path challenged: %d", resp.StatusCode)
	}
}

func TestReplayCacheFailsClosed(t *testing.T) {
	s, _ := New(Config{Secret: testSecret, ReplayCapacity: numShards})
	exp := time.Now().Add(time.Hour).Unix()
	now := time.Now().Unix()
	var failed bool
	for i := uint64(0); i < 10; i++ {
		if err := s.markUsed(i*numShards, exp, now); err != nil {
			failed = true
		}
	}
	if !failed {
		t.Fatal("full replay cache must refuse new solutions")
	}
}

