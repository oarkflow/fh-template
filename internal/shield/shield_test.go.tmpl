func TestEndpointRedeemFlow(t *testing.T) {
	p := 0.0
	app, _ := newApp(t, &p, Config{})
	// Calm: GET reports no work required.
	if _, body := doReq(t, app, "GET", "/_pow", nil); !strings.Contains(body, `"bits":0`) {
		t.Fatalf("calm GET: %s", body)
	}
	p = 1.0
	_, body := doReq(t, app, "GET", "/_pow", nil)
	var ch challengeBody
	if err := json.Unmarshal([]byte(body), &ch); err != nil || ch.Bits != 12 {
		t.Fatalf("GET under pressure: %s", body)
	}
	// Redeem with a wrong counter, then the right one.
	if resp, _ := doReq(t, app, "POST", "/_pow", map[string]string{HeaderSolution: ch.Challenge + ".0"}); resp.StatusCode == 204 {
		t.Skip("counter 0 happened to solve it")
	}
	resp, _ := doReq(t, app, "POST", "/_pow", map[string]string{HeaderSolution: solve(ch.Challenge, ch.Bits)})
	if resp.StatusCode != 204 {
		t.Fatalf("redeem: %d", resp.StatusCode)
	}
	var pass string
	for _, c := range resp.Cookies() {
		if c.Name == "fh_pass" {
			pass = c.Value
		}
	}
	if resp, _ := doReq(t, app, "GET", "/api/x", map[string]string{"Cookie": "fh_pass=" + pass}); resp.StatusCode != 200 {
		t.Fatalf("pass from redeem rejected: %d", resp.StatusCode)
	}
	if resp, _ := doReq(t, app, "PUT", "/_pow", nil); resp.StatusCode != 405 {
		t.Fatalf("PUT: %d", resp.StatusCode)
	}
}

func TestInvalidSolutionsEscalateToBan(t *testing.T) {
	p := 1.0
	now := time.Unix(1_700_000_000, 0)
	var ip string
	app, s := newApp(t, &p, Config{Now: func() time.Time { return now }, StrikeLimit: 8, BanBase: 30 * time.Second,
		OnEvent: func(_, addr string, _ int) { ip = addr }})
	for i := 0; i < 4; i++ { // 4 invalid x weight 2 = 8 strikes
		if resp, _ := do(t, app, map[string]string{HeaderSolution: "bogus.challenge.1"}); resp.StatusCode != 429 {
			t.Fatalf("attempt %d: %d", i, resp.StatusCode)
		}
	}
	resp, body := do(t, app, nil)
	if resp.StatusCode != 403 || !strings.Contains(body, "temporarily_blocked") || resp.Header.Get("Retry-After") == "" {
		t.Fatalf("expected ban, got %d %s", resp.StatusCode, body)
	}
	if s.Banned.Load() != 1 {
		t.Fatalf("banned=%d", s.Banned.Load())
	}
	// Ban outlives calm: drop pressure to zero, still blocked.
	p = 0
	if resp, _ := do(t, app, nil); resp.StatusCode != 403 {
		t.Fatalf("ban must hold while calm: %d", resp.StatusCode)
	}
	// Expires, then a repeat offence doubles the ban.
	now = now.Add(31 * time.Second)
	if resp, _ := do(t, app, nil); resp.StatusCode != 200 {
		t.Fatalf("ban should have expired: %d", resp.StatusCode)
	}
	p = 1.0
	for i := 0; i < 4; i++ {
		do(t, app, map[string]string{HeaderSolution: "bogus.challenge.1"})
	}
	if _, banned := s.strikes.banned(ip, now.Add(45*time.Second)); !banned {
		t.Fatal("second ban should be 60s (doubled), still active at +45s")
	}
	if _, banned := s.strikes.banned(ip, now.Add(61*time.Second)); banned {
		t.Fatal("second ban should have ended by +61s")
	}
}

func TestChallengeHammeringIsStruck(t *testing.T) {
	p := 1.0
	app, s := newApp(t, &p, Config{HammerLimit: 5, StrikeLimit: 3})
	var last int
	for i := 0; i < 20; i++ {
		resp, _ := do(t, app, nil)
		last = resp.StatusCode
	}
	if last != 403 || s.Banned.Load() == 0 {
		t.Fatalf("hammering without solving must end in a ban (last=%d)", last)
	}
}

func TestPassBudgetStopsSolvedOnceFlood(t *testing.T) {
	p := 1.0
	app, s := newApp(t, &p, Config{PassBudget: 5, StrikeLimit: 1000})
	ch := getChallenge(t, app)
	resp, _ := do(t, app, map[string]string{HeaderSolution: solve(ch.Challenge, ch.Bits)})
	var pass string
	for _, c := range resp.Cookies() {
		if c.Name == "fh_pass" {
			pass = c.Value
		}
	}
	ok, limited := 0, 0
	for i := 0; i < 12; i++ {
		resp, body := do(t, app, map[string]string{"Cookie": "fh_pass=" + pass})
		switch resp.StatusCode {
		case 200:
			ok++
		case 429:
			if !strings.Contains(body, "pass_budget_exceeded") {
				t.Fatalf("429 body: %s", body)
			}
			limited++
		}
	}
	if ok != 5 || limited != 7 || s.BudgetExceeded.Load() != 7 {
		t.Fatalf("ok=%d limited=%d exceeded=%d", ok, limited, s.BudgetExceeded.Load())
	}
}

func TestEndpointRateLimited(t *testing.T) {
	p := 1.0
	app, _ := newApp(t, &p, Config{EndpointRate: 3, StrikeLimit: 1000})
	var codes []int
	for i := 0; i < 6; i++ {
		resp, _ := doReq(t, app, "GET", "/_pow", nil)
		codes = append(codes, resp.StatusCode)
	}
	if codes[2] != 200 || codes[3] != 429 {
		t.Fatalf("codes=%v", codes)
	}
}

func TestExtraPressureRaisesDifficulty(t *testing.T) {
	shared := 0.0
	s, _ := New(Config{Secret: testSecret, ExtraPressure: func() float64 { return shared }})
	if s.Bits(s.Pressure()) != 0 {
		t.Fatal("calm")
	}
	shared = 1.0
	if s.Bits(s.Pressure()) == 0 {
		t.Fatal("fleet pressure must raise difficulty")
	}
}

func TestTrackerStaysBoundedUnderKeyFlood(t *testing.T) {
	tr := newTracker(160)
	now := time.Now()
	for i := 0; i < 100_000; i++ {
		tr.hit("k"+strconv.Itoa(i), 1, time.Hour, now)
	}
	if n := tr.len(); n > 160+numShards {
		t.Fatalf("tracker grew to %d entries", n)
	}
}
