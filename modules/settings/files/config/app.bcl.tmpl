# ── Authentication ─────────────────────────────────────────────────────────
auth {
  sources ["bootstrap"]           # add "local" (accounts module) and others here
  identifier "email"              # what people type: email | username | phone
  min_password_length 12
  otp_ttl_seconds 600
  session_minutes 30

  lockout {
    max_failures 5
    lock_minutes 15
  }

  mfa {
    totp "optional"               # off | optional | required
    issuer "My App"
  }
}

# ── Key management (vault module) ──────────────────────────────────────────
vault {
  backend "env"                   # env: APP_VAULT_KEY | secretr: encrypted key store under dir
  dir "data/kms"                  # secretr only
}
