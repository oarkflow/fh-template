# Application settings. Everything here is read at startup; edit and restart.
# Validate with:  bcl validate config/app.bcl

# ── Tenancy ────────────────────────────────────────────────────────────────
# single: one implicit tenant, nothing in the UI or API mentions tenants.
# multi:  accounts, roles and data are isolated per tenant; login names a tenant.
tenancy {
  mode "single"
  default "default"
}

# ── Roles ──────────────────────────────────────────────────────────────────
# Permissions are "resource:action" strings. "*" grants everything; there are no partial wildcards. These are only the defaults:
# with the rbac module they are seeded into the database and then editable in the
# admin UI (per tenant when tenancy is multi).
role "admin" {
  title "Administrator"
  description "Full access, including access control and audit."
  permissions ["*"]
  staff true
}

role "editor" {
  title "Editor"
  description "Can create and change content."
  permissions ["notes:read", "notes:write"]
  staff true
}

role "viewer" {
  title "Viewer"
  description "Read-only access."
  permissions ["notes:read"]
}

# ── Self-registration ──────────────────────────────────────────────────────
registration {
  enabled false
  default_role "viewer"
  verify "email"        # email | phone | none
}

# ── Identity datasources ───────────────────────────────────────────────────
# Where accounts and credentials live. auth.sources lists them in the order they
# are tried at login. kind is one of:
#   builtin  the accounts table managed by the accounts module (registration,
#            OTP, TOTP, staff management all work on it)
#   static   users listed right here; secrets come from environment variables
#   sql      an existing user table you already have, read with your own query

datasource "local" {
  kind "builtin"
}

# Development convenience: the APP_LOGIN_USER / APP_LOGIN_PASSWORD account.
datasource "bootstrap" {
  kind "static"
  user "admin" {
    name "Administrator"
    password_env "APP_LOGIN_PASSWORD"
    roles ["admin"]
  }
}

# Example of an external user table (uncomment and adjust):
