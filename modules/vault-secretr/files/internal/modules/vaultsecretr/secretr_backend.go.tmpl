package vaultsecretr

import (
	"context"
	"encoding/json"
	"errors"
	"os"
	"path/filepath"
	"sort"
	"strings"
	"sync"

	"github.com/oarkflow/secretr/pkg/storage"
)

// fileBackend is a minimal secretr storage.Backend: a key-value map persisted atomically to
// one file. Everything it stores is already encrypted by secretr's Store (AES-256-GCM under
// the operator's master key), so the file holds ciphertext only. The key set is tiny (a few
// KEKs), so rewriting the file on each change is fine and keeps recovery trivial.
type fileBackend struct {
	mu   sync.Mutex
	path string
	data map[string][]byte
	mk   []byte
}

func openFileBackend(dir string, masterKey []byte) (*fileBackend, error) {
	if err := os.MkdirAll(dir, 0o700); err != nil {
		return nil, err
	}
	b := &fileBackend{path: filepath.Join(dir, "kms.db"), data: map[string][]byte{}, mk: append([]byte(nil), masterKey...)}
	raw, err := os.ReadFile(b.path)
	switch {
	case errors.Is(err, os.ErrNotExist):
	case err != nil:
		return nil, err
	default:
		if err := json.Unmarshal(raw, &b.data); err != nil {
			return nil, err
		}
	}
	return b, nil
}

func (b *fileBackend) flush() error {
	raw, err := json.Marshal(b.data)
	if err != nil {
		return err
	}
	tmp := b.path + ".tmp"
	if err := os.WriteFile(tmp, raw, 0o600); err != nil {
		return err
	}
	return os.Rename(tmp, b.path)
}

func (b *fileBackend) Get(_ context.Context, key []byte) ([]byte, error) {
	b.mu.Lock()
	defer b.mu.Unlock()
	v, ok := b.data[string(key)]
	if !ok {
		return nil, storage.ErrNotFound
	}
	return append([]byte(nil), v...), nil
}

func (b *fileBackend) Put(_ context.Context, key, val []byte) error {
	b.mu.Lock()
	defer b.mu.Unlock()
	b.data[string(key)] = append([]byte(nil), val...)
	return b.flush()
}

func (b *fileBackend) Delete(_ context.Context, key []byte) error {
	b.mu.Lock()
	defer b.mu.Unlock()
	delete(b.data, string(key))
	return b.flush()
}

func (b *fileBackend) Keys(_ context.Context, prefix string) ([]string, error) {
	b.mu.Lock()
	defer b.mu.Unlock()
	var out []string
	for k := range b.data {
		if strings.HasPrefix(k, prefix) {
			out = append(out, k)
		}
	}
	sort.Strings(out)
	return out, nil
}

func (b *fileBackend) MasterKey() []byte { return append([]byte(nil), b.mk...) }
func (b *fileBackend) Close() error      { return nil }

var errNoObjects = errors.New("vaultsecretr: object storage is not used by the KMS")

func (b *fileBackend) StoreObject(string, string, string, []byte, *storage.ObjectOptions) error {
	return errNoObjects
}
func (b *fileBackend) GetObject(string, string) ([]byte, error) { return nil, errNoObjects }
func (b *fileBackend) ListObjects(string, int) ([]storage.ObjectEntry, error) {
	return nil, errNoObjects
}
func (b *fileBackend) DeleteObject(string, string) error { return errNoObjects }
