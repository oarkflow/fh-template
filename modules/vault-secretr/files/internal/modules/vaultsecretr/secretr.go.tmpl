// Package kms is the production key-management backend: key-encryption keys and the
// blind-index key live in a github.com/oarkflow/secretr encrypted store and are managed by
// secretr's key manager. Only the store's master key (a 32-byte secret supplied by the
// operator) is held outside it. Satisfies vault.KMS.
package vaultsecretr

import (
	"context"
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"errors"
	"fmt"
	"path/filepath"
	"sort"
	"sync"

	"github.com/oarkflow/secretr/pkg/core/keys"
	"github.com/oarkflow/secretr/pkg/storage"
	"github.com/oarkflow/secretr/pkg/types"
)

const (
	roleKey   = "fh_role"
	roleKEK   = "kek"
	roleIndex = "index"
)

// Secretr is a vault.KMS backed by secretr. A KEK "version" is the secretr key ID, so old
// DEKs stay unwrappable after a rotation until they are rewrapped.
type Secretr struct {
	ctx   context.Context
	store *storage.Store
	mgr   *keys.Manager
	mu    sync.RWMutex
	cur   string
	index []byte
}

// Open opens (creating on first use) the secretr store under dir, protected by masterKey.
func Open(dir string, masterKey []byte) (*Secretr, error) {
	if len(masterKey) != 32 {
		return nil, errors.New("vaultsecretr: master key must be 32 bytes")
	}
	// secretr wipes key slices it is given, so every consumer gets its own copy and the
	// caller's slice is left intact.
	cp := func() []byte { return append([]byte(nil), masterKey...) }
	be, err := openFileBackend(filepath.Join(dir, "secretr"), cp())
	if err != nil {
		return nil, fmt.Errorf("vaultsecretr: open key file: %w", err)
	}
	store, err := storage.NewStore(storage.Config{Path: filepath.Join(dir, "secretr"), EncryptionKey: cp(), Backend: be, DisableDeviceBinding: true})
	if err != nil {
		return nil, fmt.Errorf("vaultsecretr: open secretr store: %w", err)
	}
	existing, _ := be.Keys(context.Background(), "") // before NewManager, which seeds its own key
	mgr, err := keys.NewManager(keys.ManagerConfig{Store: store, MasterKey: cp()})
	if err != nil {
		store.Close()
		return nil, fmt.Errorf("vaultsecretr: key manager: %w", err)
	}
	k := &Secretr{ctx: context.Background(), store: store, mgr: mgr}
	if err := k.ensure(len(existing) > 0); err != nil {
		k.Close()
		return nil, err
	}
	return k, nil
}

func (k *Secretr) Close() error {
	k.mgr.Close()
	return k.store.Close()
}

func (k *Secretr) role(r string) ([]*types.Key, error) {
	all, err := k.mgr.ListKeys(k.ctx, keys.ListKeysOptions{Type: types.KeyTypeEncryption, Status: types.StatusActive})
	if err != nil {
		return nil, err
	}
	var out []*types.Key
	for _, key := range all {
		if key.Metadata[roleKey] == r {
			out = append(out, key)
		}
	}
	sort.Slice(out, func(i, j int) bool { return out[i].CreatedAt < out[j].CreatedAt })
	return out, nil
}

// ensure creates the KEK and index key on first use. When the file already holds keys but they
// cannot be read, the master key is wrong or the file is damaged: creating fresh keys then would
// silently orphan every encrypted record, so it fails instead.
func (k *Secretr) ensure(hadData bool) error {
	for _, r := range []string{roleKEK, roleIndex} {
		ks, err := k.role(r)
		if err != nil {
			return err
		}
		if len(ks) == 0 {
			if hadData {
				return errors.New("vaultsecretr: the key store has data but no readable " + r + " key: wrong master key, damaged file, or a store created before device binding was disabled ")
			}
			if _, err := k.mgr.GenerateKey(k.ctx, keys.GenerateKeyOptions{Type: types.KeyTypeEncryption, Purpose: types.KeyPurposeEncrypt, Metadata: types.Metadata{roleKey: r}}); err != nil {
				return fmt.Errorf("vaultsecretr: create %s key: %w", r, err)
			}
		}
	}
	return k.refresh()
}

func (k *Secretr) refresh() error {
	keks, err := k.role(roleKEK)
	if err != nil || len(keks) == 0 {
		return fmt.Errorf("vaultsecretr: no KEK available: %v", err)
	}
	idx, err := k.role(roleIndex)
	if err != nil || len(idx) == 0 {
		return fmt.Errorf("vaultsecretr: no index key available: %v", err)
	}
	material, err := k.mgr.GetKey(k.ctx, idx[0].ID)
	if err != nil {
		return err
	}
	k.mu.Lock()
	k.cur, k.index = string(keks[len(keks)-1].ID), material
	k.mu.Unlock()
	return nil
}

// Rotate creates a new KEK and makes it current. Existing DEKs keep unwrapping with their old
// KEK until Vault.Rewrap moves them .
func (k *Secretr) Rotate() (string, error) {
	key, err := k.mgr.GenerateKey(k.ctx, keys.GenerateKeyOptions{Type: types.KeyTypeEncryption, Purpose: types.KeyPurposeEncrypt, Metadata: types.Metadata{roleKey: roleKEK}})
	if err != nil {
		return "", err
	}
	return string(key.ID), k.refresh()
}

func (k *Secretr) CurrentVersion() string { k.mu.RLock(); defer k.mu.RUnlock(); return k.cur }
func (k *Secretr) IndexKey() []byte       { k.mu.RLock(); defer k.mu.RUnlock(); return k.index }

func (k *Secretr) aead(version string) (cipher.AEAD, error) {
	material, err := k.mgr.GetKey(k.ctx, types.ID(version))
	if err != nil {
		return nil, fmt.Errorf("vaultsecretr: KEK %q: %w", version, err)
	}
	b, err := aes.NewCipher(material)
	if err != nil {
		return nil, err
	}
	return cipher.NewGCM(b)
}

func (k *Secretr) Wrap(version string, dek, aad []byte) ([]byte, error) {
	a, err := k.aead(version)
	if err != nil {
		return nil, err
	}
	nonce := make([]byte, a.NonceSize())
	if _, err := rand.Read(nonce); err != nil {
		return nil, err
	}
	return a.Seal(nonce, nonce, dek, aad), nil
}

func (k *Secretr) Unwrap(version string, wrapped, aad []byte) ([]byte, error) {
	a, err := k.aead(version)
	if err != nil {
		return nil, err
	}
	if len(wrapped) < a.NonceSize() {
		return nil, errors.New("vaultsecretr: wrapped key too short")
	}
	return a.Open(nil, wrapped[:a.NonceSize()], wrapped[a.NonceSize():], aad)
}
