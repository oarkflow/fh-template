package vaultsecretr

import (
	"__FH_MODULE__/internal/modules/vault"
	"bytes"
	"crypto/rand"
	"testing"

)

var _ vault.KMS = (*Secretr)(nil)

func master() []byte { b := make([]byte, 32); _, _ = rand.Read(b); return b }

func TestWrapRotateAndPersist(t *testing.T) {
	dir, mk := t.TempDir(), master()
	k, err := Open(dir, mk)
	if err != nil {
		t.Fatal(err)
	}
	v1, idx := k.CurrentVersion(), append([]byte(nil), k.IndexKey()...)
	if v1 == "" || len(idx) != 32 {
		t.Fatalf("version %q index %d", v1, len(idx))
	}
	dek, aad := []byte("0123456789abcdef0123456789abcdef"), []byte("subject-1")
	w, err := k.Wrap(v1, dek, aad)
	if err != nil || bytes.Contains(w, dek) {
		t.Fatalf("wrap: %v", err)
	}
	if got, err := k.Unwrap(v1, w, aad); err != nil || !bytes.Equal(got, dek) {
		t.Fatalf("unwrap: %v", err)
	}
	if _, err := k.Unwrap(v1, w, []byte("other")); err == nil {
		t.Fatal("unwrapped under a different AAD")
	}
	v2, err := k.Rotate()
	if err != nil || v2 == v1 || k.CurrentVersion() != v2 {
		t.Fatalf("rotate: %v %q %q", err, v1, v2)
	}
	if got, err := k.Unwrap(v1, w, aad); err != nil || !bytes.Equal(got, dek) {
		t.Fatalf("old KEK must still unwrap after rotation: %v", err)
	}
	k.Close()

	k2, err := Open(dir, mk)
	if err != nil {
		t.Fatalf("reopen: %v", err)
	}
	defer k2.Close()
	if k2.CurrentVersion() != v2 || !bytes.Equal(k2.IndexKey(), idx) {
		t.Fatal("keys did not persist across a restart")
	}
	if got, err := k2.Unwrap(v1, w, aad); err != nil || !bytes.Equal(got, dek) {
		t.Fatalf("after restart: %v", err)
	}
	if _, err := Open(dir, master()); err == nil {
		t.Fatal("opened the store with the wrong master key")
	}
}

func TestVaultOverSecretrWithRewrap(t *testing.T) {
	k, err := Open(t.TempDir(), master())
	if err != nil {
		t.Fatal(err)
	}
	defer k.Close()
	v := vault.New(k, vault.NewMemoryKeyStore())
	enc, err := v.Encrypt("s1", "profiles", "name", "r1", []byte("Asha Rai"))
	if err != nil {
		t.Fatal(err)
	}
	if _, err := k.Rotate(); err != nil {
		t.Fatal(err)
	}
	if err := v.Rewrap("s1"); err != nil {
		t.Fatal(err)
	}
	if got, err := v.Decrypt("s1", "profiles", "name", "r1", enc); err != nil || string(got) != "Asha Rai" {
		t.Fatalf("%q %v", got, err)
	}
	if a, b := v.BlindIndex("email", "a@x.io"), v.BlindIndex("email", "a@x.io"); a != b || a == "" {
		t.Fatal("blind index unstable")
	}
}
