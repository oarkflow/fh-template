package accounts

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"strings"
	"sync"
	"time"
)

// DevNotifier is the development delivery channel: it never leaves the process.
// It remembers the newest message per recipient so a local UI can show the code,
// and logs only the kind, never the code. It must not be used in production.
type DevNotifier struct {
	mu   sync.Mutex
	last map[string]string
}

func NewDevNotifier() *DevNotifier { return &DevNotifier{last: map[string]string{}} }

func (d *DevNotifier) Send(_ context.Context, channel, to, kind, message string) error {
	d.mu.Lock()
	d.last[to+"|"+kind] = message
	d.mu.Unlock()
	log.Printf("dev notifier: %s %s queued for %s (development only)", kind, channel, to)
	return nil
}

// LastOTP extracts the six-digit code from the newest OTP message sent to `to`.
func (d *DevNotifier) LastOTP(to string) string {
	d.mu.Lock()
	msg := d.last[to+"|otp"]
	d.mu.Unlock()
	for i := 0; i+6 <= len(msg); i++ {
		ok := true
		for _, r := range msg[i : i+6] {
			if r < '0' || r > '9' {
				ok = false
				break
			}
		}
		if ok && (i+6 == len(msg) || msg[i+6] < '0' || msg[i+6] > '9') && (i == 0 || msg[i-1] < '0' || msg[i-1] > '9') {
			return msg[i : i+6]
		}
	}
	return ""
}

// HTTPNotifier posts messages to an operator-run delivery gateway (SMS/email).
// The URL and token are operator configuration, never request data.
type HTTPNotifier struct {
	URL, Token string
	Client     *http.Client
}

func (h HTTPNotifier) Send(ctx context.Context, channel, to, kind, message string) error {
	body, _ := json.Marshal(map[string]string{"channel": channel, "to": to, "kind": kind, "message": message})
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, h.URL, bytes.NewReader(body))
	if err != nil {
		return err
	}
	req.Header.Set("Content-Type", "application/json")
	if h.Token != "" {
		req.Header.Set("Authorization", "Bearer "+h.Token)
	}
	c := h.Client
	if c == nil {
		c = &http.Client{Timeout: 10 * time.Second}
	}
	resp, err := c.Do(req)
	if err != nil {
		return fmt.Errorf("notifier: %w", err)
	}
	defer resp.Body.Close()
	if resp.StatusCode/100 != 2 {
		return fmt.Errorf("notifier: gateway returned %d", resp.StatusCode)
	}
	return nil
}

// MemoryNotifier records messages (tests).
type MemoryNotifier struct{ Sent []Message }

type Message struct{ Channel, To, Kind, Body string }

func (m *MemoryNotifier) Send(_ context.Context, ch, to, kind, body string) error {
	m.Sent = append(m.Sent, Message{ch, to, kind, body})
	return nil
}

// LastCode extracts the six-digit code from the most recent OTP message.
func (m *MemoryNotifier) LastCode() string {
	for i := len(m.Sent) - 1; i >= 0; i-- {
		if m.Sent[i].Kind == "otp" {
			for _, f := range strings.Fields(m.Sent[i].Body) {
				f = strings.Trim(f, ".")
				if len(f) == 6 && digits(f) == f {
					return f
				}
			}
		}
	}
	return ""
}
