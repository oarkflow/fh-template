package accounts

import (
	"context"
	"crypto/subtle"
	"database/sql"
	"errors"
	"fmt"
	"os"
	"strings"

	"__FH_MODULE__/internal/modules/settings"
	"github.com/oarkflow/squealx"
	"github.com/oarkflow/squealx/drivers/sqlite"
)

// Record is what a datasource knows about one account.
type Record struct {
	ID     string
	Name   string
	Tenant string
	Roles  []string
	Source string
	Active bool

	// Exactly one of Hash (with HashKind) or Plain is set. Plain exists only
	// for static development users whose secret lives in the environment.
	Hash     string
	HashKind string
	Plain    string

	TOTPSecret  string // base32; empty when the account has no authenticator
	TOTPEnabled bool
}

// PasswordOK checks a candidate password without leaking timing on the compare.
func (r *Record) PasswordOK(password string) bool {
	if r.Plain != "" {
		return subtle.ConstantTimeCompare([]byte(r.Plain), []byte(password)) == 1
	}
	return Check(r.HashKind, password, r.Hash)
}

// Source looks accounts up. Lookup returns (nil, nil) when nobody matches.
type Source interface {
	ID() string
	Lookup(ctx context.Context, tenant, identifier string) (*Record, error)
}

// buildSources instantiates the datasources the auth settings name, in order.
func buildSources(cfg *settings.Settings, svc *Service, appDB *squealx.DB) ([]Source, error) {
	byID := map[string]settings.Source{}
	for _, s := range cfg.Sources {
		byID[s.ID] = s
	}
	var out []Source
	for _, id := range cfg.Auth.Sources {
		def := byID[id]
		switch def.Kind {
		case "builtin":
			out = append(out, builtinSource{id: id, svc: svc})
		case "static":
			out = append(out, staticSource{id: id, users: def.Users, defaultTenant: cfg.Tenancy.Default})
		case "sql":
			src, err := newSQLSource(def, cfg.Tenancy.Default, appDB)
			if err != nil {
				return nil, err
			}
			out = append(out, src)
		}
	}
	return out, nil
}

// ── builtin: the accounts table ───────────────────────────────────────────

type builtinSource struct {
	id  string
	svc *Service
}

func (b builtinSource) ID() string { return b.id }

func (b builtinSource) Lookup(ctx context.Context, tenant, identifier string) (*Record, error) {
	a, err := b.svc.find(ctx, tenant, identifier)
	if errors.Is(err, sql.ErrNoRows) {
		return nil, nil
	}
	if err != nil {
		return nil, err
	}
	rec := &Record{
		ID: a.ID, Name: a.Name, Tenant: a.TenantID, Roles: []string{a.Role}, Source: b.id, Active: a.Status == "active",
		Hash: a.PasswordHash, HashKind: "argon2id", TOTPEnabled: a.TOTPEnabled == 1,
	}
	if rec.TOTPEnabled {
		if secret, err := b.svc.Vault.Decrypt(a.ID, "accounts", "totp", a.ID, a.TOTPSecret); err == nil {
			rec.TOTPSecret = string(secret)
		} else {
			rec.TOTPEnabled = false
			rec.Active = false // an unreadable authenticator must not silently downgrade to password-only
		}
	}
	return rec, nil
}

// ── static: users written in config/app.bcl ───────────────────────────────

type staticSource struct {
	id            string
	users         []settings.StaticUser
	defaultTenant string
}

func (s staticSource) ID() string { return s.id }

func (s staticSource) Lookup(_ context.Context, tenant, identifier string) (*Record, error) {
	for _, u := range s.users {
		if !strings.EqualFold(u.ID, identifier) {
			continue
		}
		t := u.Tenant
		if t == "" {
			t = s.defaultTenant
		}
		if t != tenant {
			continue
		}
		rec := &Record{ID: u.ID, Name: u.Name, Tenant: t, Roles: u.Roles, Source: s.id, Active: true}
		if rec.Name == "" {
			rec.Name = u.ID
		}
		if u.PasswordHashEnv != "" {
			rec.Hash = os.Getenv(u.PasswordHashEnv)
			rec.HashKind = KindOf(rec.Hash)
		} else if u.PasswordEnv != "" {
			rec.Plain = os.Getenv(u.PasswordEnv)
		}
		if rec.Plain == "" && rec.Hash == "" {
			rec.Active = false // no secret configured: the user exists but cannot sign in
		}
		return rec, nil
	}
	return nil, nil
}

// ── sql: an existing user table, read with the operator's own query ───────

type sqlSource struct {
	id            string
	def           settings.Source
	db            *squealx.DB
	defaultTenant string
}

func newSQLSource(def settings.Source, defaultTenant string, appDB *squealx.DB) (Source, error) {
	db := appDB
	if dsn := os.Getenv(def.DSNEnv); def.DSNEnv != "" && dsn != "" {
		switch def.Driver {
		case "", "sqlite":
			opened, err := sqlite.Open(dsn, "datasource-"+def.ID)
			if err != nil {
				return nil, fmt.Errorf("datasource %s: %w", def.ID, err)
			}
			db = opened
		default:
			return nil, fmt.Errorf("datasource %s: driver %q is not compiled into this application", def.ID, def.Driver)
		}
	}
	return &sqlSource{id: def.ID, def: def, db: db, defaultTenant: defaultTenant}, nil
}

func (s *sqlSource) ID() string { return s.id }

func (s *sqlSource) Lookup(ctx context.Context, tenant, identifier string) (*Record, error) {
	args := []any{identifier}
	if strings.Count(s.def.Lookup, "?") >= 2 {
		args = []any{tenant, identifier}
	}
	rows, err := s.db.QueryContext(ctx, s.def.Lookup, args...)
	if err != nil {
		return nil, fmt.Errorf("datasource %s: %w", s.id, err)
	}
	defer rows.Close()
	if !rows.Next() {
		return nil, rows.Err()
	}
	cols, err := rows.Columns()
	if err != nil {
		return nil, err
	}
	values := make([]any, len(cols))
	pointers := make([]any, len(cols))
	for i := range values {
		pointers[i] = &values[i]
	}
	if err := rows.Scan(pointers...); err != nil {
		return nil, err
	}
	row := map[string]string{}
	for i, c := range cols {
		switch v := values[i].(type) {
		case nil:
			row[c] = ""
		case []byte:
			row[c] = string(v)
		default:
			row[c] = fmt.Sprint(v)
		}
	}
	c := s.def.Cols
	rec := &Record{
		ID: row[c.ID], Name: row[c.Name], Tenant: s.defaultTenant, Source: s.id,
		Hash: row[c.Password], HashKind: s.def.Hash, Active: true,
	}
	if c.Tenant != "" && row[c.Tenant] != "" {
		rec.Tenant = row[c.Tenant]
	}
	if rec.Tenant != tenant {
		return nil, nil
	}
	if rec.Name == "" {
		rec.Name = rec.ID
	}
	if c.Roles != "" {
		for _, r := range strings.Split(row[c.Roles], ",") {
			if r = strings.TrimSpace(r); r != "" {
				rec.Roles = append(rec.Roles, r)
			}
		}
	}
	if c.Status != "" {
		switch strings.ToLower(row[c.Status]) {
		case "active", "1", "true", "t", "yes", "enabled":
		default:
			rec.Active = false
		}
	}
	if c.TOTP != "" && row[c.TOTP] != "" {
		rec.TOTPSecret, rec.TOTPEnabled = row[c.TOTP], true
	}
	if rec.ID == "" {
		return nil, fmt.Errorf("datasource %s: lookup returned a row without an id", s.id)
	}
	return rec, nil
}
